function greet(name)
    say "Hello, " + name + "!";
stop;

greet("world");

x = 10;
y = 3;
say x + y;

arrayTest = [3,6,5];
say arrayTest[0];

function factorial(n)
    if n < 2 do
        return 1;
    stop;
    return n * factorial(n - 1);
stop;

result = factorial(5);
say result;

i = 1;
while i < 6 do
    break;
    say i;
    i = i + 1;
stop;

if 10 > 5 do

    say 'ten is greater';
else
   say "this won't print";
stop;
